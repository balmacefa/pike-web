  on text "Cepillo Acero Con Mango 4 Lineas \\+ Pro"
    click "div.col:nth-of-type(1) > div.react-autosuggest__container > div.input-group:nth-of-type(1) > input.react-autosuggest__input"
    click "div.col:nth-of-type(1) > div.react-autosuggest__container > div.input-group:nth-of-type(1) > input.react-autosuggest__input"

recipe runpod-login
  desc Login Google SSO -> console.runpod.io dashboard
  domains console.runpod.io, accounts.google.com
  start https://console.runpod.io/
  goal url console.runpod.io/$|console.runpod.io/?|/pods|/serverless
  user text Hello,
  meta auth "google-sso"
  meta note "Sesion normalmente persiste en el perfil chrome_pike_debug; el recorder puede refinar los selectores de Google si cambian."

  on text "Create your account|Sign in"
    clickText "(Sign up|Sign in) with Google"
    wait 1500

  on text "Choose an account|demo-user"
    clickText "demo-user"
    waitText "Hello," 15000
