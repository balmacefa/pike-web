  on text "GUÍA DE PRODUCTOS"
    click "div.col:nth-of-type(1) > div.react-autosuggest__container > div.input-group:nth-of-type(1) > input.react-autosuggest__input"
    type "div.col:nth-of-type(1) > div.react-autosuggest__container > div.input-group:nth-of-type(1) > input.react-autosuggest__input" "Buscar"

  on text "CARRITO DE COMPRAS"
