  on text "Do you want to log in"
    clickText "^Authorize$"
    waitText "Add application|Application gateway" 20000

  on text "Powered by WordPress"
    type "#user_login" "${ISV_USER}"
    type "#user_pass" "${ISV_PASS}"
    click "#wp-submit"
    waitText "Do you want to log in|Add application|Application gateway" 20000

recipe isv-flows
  desc Cambiar los LOGIN FLOWS (sign-in options / identity providers)
  domains ${ISV_TENANT}
  start https://${ISV_TENANT}/ui/admin/security/sign-in-options
  goal url /security/sign-in-options
  user sel .pf-c-page

  on text "Choose an option"
    click "#dropdown-text"
    wait 700
    clickText "^WordPress OIDC$"
    waitText "Powered by WordPress|Lost your password|Add application|Application gateway" 15000

  on text "Do you want to log in"
    clickText "^Authorize$"
    waitText "Add application|Application gateway" 20000

  on text "Powered by WordPress"
    type "#user_login" "${ISV_USER}"
    type "#user_pass" "${ISV_PASS}"
    click "#wp-submit"
    waitText "Do you want to log in|Add application|Application gateway" 20000

recipe gh-new-issue
  desc Open a GitHub repo and start a new issue (DSL smoke recipe)
  domains github.com
  start https://github.com/balmacefa/pike-web
  goal url /issues/new
  user sel .AppHeader-user img, .avatar

  on text "Issues"
    clickText "Issues"
    waitText "New issue" 10000

  on text "New issue"
    clickText "New issue"
    waitSel "#issue_title"

  on url "/issues/new"
    click "#issue_title"
    type "#issue_title" "Tracking: recipe DSL smoke"
