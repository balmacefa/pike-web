{
  "recipes": {
    "wp-ibm": {
      "name": "wp-ibm",
      "desc": "Login SSO IBM Verify -> WordPress wp-admin (self-healing via IBMid -> Google)",
      "domains": [
        "${ISV_TENANT}",
        "login.ibm.com",
        "${WP_HOST}"
      ],
      "start": "https://${ISV_TENANT}/usc",
      "goal": {
        "urlMatch": "/wp-admin"
      },
      "user": {
        "selector": "#wp-admin-bar-my-account .display-name, #wpadminbar .display-name"
      },
      "steps": [
        {
          "at": {
            "textMatch": "Cloud Directory"
          },
          "do": [
            [
              "clickText",
              "Sign in another way"
            ],
            [
              "wait",
              600
            ],
            [
              "clickText",
              "^IBMid$"
            ],
            [
              "waitText",
              "Continue with Google|App center",
              15000
            ]
          ]
        },
        {
          "at": {
            "textMatch": "Continue with Google"
          },
          "do": [
            [
              "clickText",
              "Continue with Google"
            ],
            [
              "waitText",
              "App center",
              20000
            ]
          ]
        },
        {
          "at": {
            "textMatch": "App center"
          },
          "do": [
            [
              "waitSel",
              ".app-tile-wrapper"
            ],
            [
              "openTabClickTile",
              "WordPress Admin"
            ]
          ]
        },
        {
          "at": {
            "textMatch": "Iniciar sesión con IBM Verify"
          },
          "do": [
            [
              "clickAndWaitUrl",
              "IBM Verify",
              "/wp-admin",
              20000
            ]
          ]
        }
      ]
    },
