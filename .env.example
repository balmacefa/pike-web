# pike-web configuration -- copy to .env and fill with your values.
# .env is gitignored; never commit real secrets.

# Your IBM Verify tenant hostname (no https://)
ISV_TENANT=your-tenant.verify.ibm.com

# Admin credentials used by the isv-* login recipes
ISV_USER=your-username
ISV_PASS=your-password

# (optional) WordPress OIDC demo IdP host used by wp-ibm / isv-login
WP_HOST=your-wp.example.com

# (optional) Google account label matched in the SSO account chooser
GOOGLE_ACCOUNT=your-google-account
